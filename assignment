import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int m = sc.nextInt();

        char[][] grid = new char[n][m];

        int row = 0, col = 0;

        // Input the grid
        for (int i = 0; i < n; i++) {
            String s = sc.next();
            for (int j = 0; j < m; j++) {
                grid[i][j] = s.charAt(j);

                if (grid[i][j] == 'S') {
                    row = i;
                    col = j;
                }
            }
        }

        int k = sc.nextInt();
        String commands = sc.next();

        // Track visited cells
        boolean[][] visited = new boolean[n][m];
        visited[row][col] = true;

        // Execute commands
        for (int i = 0; i < k; i++) {

            int newRow = row;
            int newCol = col;

            char move = commands.charAt(i);

            if (move == 'U') {
                newRow--;
            } 
            else if (move == 'D') {
                newRow++;
            } 
            else if (move == 'L') {
                newCol--;
            } 
            else if (move == 'R') {
                newCol++;
            }

            // Check boundaries and desks
            if (newRow >= 0 && newRow < n &&
                newCol >= 0 && newCol < m &&
                grid[newRow][newCol] != '#') {

                row = newRow;
                col = newCol;

                visited[row][col] = true;
            }
        }

        // Count different visited cells
        int count = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (visited[i][j]) {
                    count++;
                }
            }
        }

        // Output (convert to 1-based indexing)
        System.out.println((row + 1) + " " + (col + 1));
        System.out.println(count);

        sc.close();
    }
}

