import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();
        int P = sc.nextInt();
        int N = sc.nextInt();

        boolean[][] solved = new boolean[T + 1][P];
        int[][] wrong = new int[T + 1][P];

        int[] solveCount = new int[T + 1];
        long[] penalty = new long[T + 1];

        // Read all submissions
        for (int i = 0; i < N; i++) {
            int minute = sc.nextInt();
            int team = sc.nextInt();
            char problem = sc.next().charAt(0);
            String verdict = sc.next();

            int p = problem - 'A';

            // Ignore submissions after the first AC
            if (solved[team][p]) {
                continue;
            }

            if (verdict.equals("AC")) {
                solved[team][p] = true;

                solveCount[team]++;

                penalty[team] += minute + 20L * wrong[team][p];
            }
            else if (verdict.equals("WA") ||
                     verdict.equals("TLE") ||
                     verdict.equals("RE")) {

                wrong[team][p]++;
            }

            // CE does nothing
        }

        // Find the winner
        int winner = 1;

        for (int team = 1; team <= T; team++) {

            if (solveCount[team] > solveCount[winner]) {
                winner = team;
            }
            else if (solveCount[team] == solveCount[winner]) {

                if (penalty[team] < penalty[winner]) {
                    winner = team;
                }
                else if (penalty[team] == penalty[winner] &&
                         team < winner) {
                    winner = team;
                }
            }
        }

        // Print each team's result
        for (int team = 1; team <= T; team++) {
            System.out.println(solveCount[team] + " " + penalty[team]);
        }

        // Print winner
        System.out.println(winner);

        sc.close();
    }
}

