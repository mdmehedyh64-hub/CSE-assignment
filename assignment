import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        for (int i = 0; i < T; i++) {

            String s = sc.next();

            boolean valid = true;

            // Rule 1: ID must have exactly 11 characters
            if (s.length() != 11) {
                valid = false;
            }

            if (valid) {

                // Rule 2 and 3: Check CSE and hyphens
                if (!s.substring(0, 3).equals("CSE")
                        || s.charAt(3) != '-'
                        || s.charAt(6) != '-') {
                    valid = false;
                }
            }

            if (valid) {

                // Rule 4: Check year digits
                if (!Character.isDigit(s.charAt(4))
                        || !Character.isDigit(s.charAt(5))) {
                    valid = false;
                }

                // Check year range
                if (valid) {
                    int year = Integer.parseInt(s.substring(4, 6));

                    if (year < 20 || year > 26) {
                        valid = false;
                    }
                }

                // Rule 5: Check last four digits
                for (int j = 7; j < 11; j++) {
                    if (!Character.isDigit(s.charAt(j))) {
                        valid = false;
                    }
                }

                if (s.substring(7, 11).equals("0000")) {
                    valid = false;
                }
            }

            if (valid) {
                System.out.println("VALID");
            } else {
                System.out.println("INVALID");
            }
        }

        sc.close();
    }
}

