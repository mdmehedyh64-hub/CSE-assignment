import java.util.Scanner;

public class main {

    // Decrypt a string using a Caesar cipher
    public static String decrypt(String s, int k) {

        StringBuilder result = new StringBuilder();

        for (int i = 0; i < s.length(); i++) {

            char ch = s.charAt(i);

            // Decrypt uppercase letters
            if (ch >= 'A' && ch <= 'Z') {
                ch = (char) ('A' + (ch - 'A' - k + 26) % 26);
            }

            // Decrypt lowercase letters
            else if (ch >= 'a' && ch <= 'z') {
                ch = (char) ('a' + (ch - 'a' - k + 26) % 26);
            }

            // Other characters remain unchanged
            result.append(ch);
        }

        return result.toString();
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int T = Integer.parseInt(sc.nextLine());

        for (int i = 0; i < T; i++) {

            String encrypted = sc.nextLine();

            // Try every possible secret key
            for (int k = 0; k <= 25; k++) {

                String decrypted = decrypt(encrypted, k);

                // Original string must end with "Coder"
                if (decrypted.endsWith("Coder")) {

                    System.out.println(decrypted);
                    break;
                }
            }
        }

        sc.close();
    }
}
