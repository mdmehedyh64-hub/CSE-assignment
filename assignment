import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        for (int i = 0; i < T; i++) {

            long N = sc.nextLong();
            long V = sc.nextLong();
            long J = sc.nextLong();
            long K = sc.nextLong();
            long C = sc.nextLong();

            long people = 3 * N + V + J;

            long packs = (people + K - 1) / K;

            long cost = packs * C;

            System.out.println(packs + " " + cost);
        }

        sc.close();
    }
}

